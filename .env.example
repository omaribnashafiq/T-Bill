# Copy to .env and fill in real values. Never commit the real .env file.

PORT=3000

# Long random string used to sign JWTs — required. Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of origins allowed to call the API, e.g.
#   CORS_ORIGIN=https://tbill.yourcompany.com
# Leave unset only for local development.
CORS_ORIGIN=

# Only used if/when the app is switched to the `production` (Postgres) knex
# config — see the NOTE in src/db/index.js before doing that.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional: fixes the initial admin password to a known value instead of a
# random generated one (useful for scripted/CI setups only).
SEED_ADMIN_PASSWORD=
